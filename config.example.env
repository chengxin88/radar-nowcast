# Real webhook belongs only in the server's private config.env (mode 600).
WECHAT_WEBHOOK_URL=
AUTO_PUSH_ENABLED=0
RAIN_ALERTS_ENABLED=0
ROLLING_ENABLED=0
OFFICIAL_TRIGGER_ENABLED=0
# Optional JSON mapping, bound to exact target geometry. Blank uses Civic Center/Futian preset.
OFFICIAL_PROFILE_FILE=
LIGHTNING_ENABLED=0
TZ=Asia/Shanghai
RADAR_GENERATION_TIMEOUT_SECONDS=180
SEND_DEADLINE_MINUTES=15
DRAFT_MAX_AGE_MINUTES=10
CACHE_RETENTION_DAYS=7
RAIN_ALERT_LEAD_MINUTES=30
RAIN_ALERT_CONFIRM_FRAMES=2
RAIN_ALERT_COOLDOWN_MINUTES=30
RADAR_TARGET_NAME=市民中心
RADAR_TARGET_LAT=22.543
RADAR_TARGET_LON=114.059
RADAR_TARGET_RADIUS_KM=3
RADAR_RAIN_DBZ=25
RADAR_STRONG_DBZ=35
RADAR_SUPPORT_FRACTION=0.10
RADAR_SUPPORT_PIXELS=3
